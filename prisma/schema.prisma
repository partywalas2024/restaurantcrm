// Partywalas — multi-restaurant Supply & Expense CRM platform.
//
// Every restaurant (e.g. Junction 14) is a tenant: its own vendors, bills,
// products, sales, menu, users — invisible to every other restaurant. A
// Partywalas SUPER_ADMIN account sits above all restaurants and can create
// them and grant access, but cannot read their business data — enforced in
// the application layer (see requireRestaurantUser in src/lib/auth.ts), not
// just by convention, since every restaurant-scoped query requires a
// restaurantId that a SUPER_ADMIN session simply does not have.
//
// Bills remain the source of truth within a restaurant; Expenses/Inventory
// are derived views over Bill + BillLineItem so purchase data never has to
// be entered twice.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
  UNKNOWN
}

enum BillType {
  INVOICE
  RETURN
}

enum ProductCategory {
  RAW_MATERIALS
  GRAINS_FLOURS
  PULSES_DALS
  SPICES_MASALAS
  OILS_GHEE
  DAIRY
  CONDIMENTS_SAUCES
  SNACKS_NAMKEEN
  BEVERAGES
  PACKAGING
  CLEANING_SUPPLIES
  KITCHEN_SUPPLIES
  UTILITIES
  TRANSPORT
  MAINTENANCE
  OTHER
}

enum MovementType {
  PURCHASE
  RETURN
  ADJUSTMENT
  CONSUMPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

// A tenant. Replaces the old singleton RestaurantProfile — there is now one
// row per restaurant instead of exactly one row total, and every piece of
// business data hangs off a specific restaurant's id.
model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  vendors        Vendor[]
  bills          Bill[]
  products       Product[]
  menuItems      MenuItem[]
  dailySales     DailySales[]
  laborCosts     LaborCost[]
  wasteEntries   WasteEntry[]
  activityLogs   ActivityLog[]
  customers      Customer[]
  customerVisits CustomerVisit[]
  stockCounts    StockCount[]
  expenses       Expense[]
  statements     ExpenseStatement[]
  cashReceipts   CashReceipt[]
}

model Vendor {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  address      String?
  gstin        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bills      Bill[]
  products   Product[]
  payments   Payment[]

  // Same vendor NAME can recur across different restaurants — they are
  // different suppliers as far as each restaurant's books are concerned, or
  // even the same real-world supplier with two independent ledgers. Only
  // unique *within* a restaurant, which is what makes the case-insensitive
  // dedup match correctly per-tenant instead of across tenants.
  @@unique([restaurantId, name])
  @@index([restaurantId])
}

// A payment made to a vendor. Combined with that vendor's Bills, this is the
// ledger: INVOICE bills and RETURN bills are debits/credits on account, and
// Payments are credits — the running balance is always derived, never
// hand-typed, so it can't drift from reality.
//
// No restaurantId here: a Payment always belongs to a Vendor, and a Vendor
// always belongs to exactly one Restaurant, so scoping queries through
// `vendor: { restaurantId }` is both sufficient and avoids a column that
// could drift out of sync with its parent.
model Payment {
  id        String        @id @default(cuid())
  vendorId  String
  date      DateTime
  amount    Float
  method    PaymentMethod @default(OTHER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([date])
}

model Product {
  id               String          @id @default(cuid())
  restaurantId     String
  name             String
  category         ProductCategory @default(OTHER)
  unit             String
  hsn              String?
  currentStock     Float           @default(0)
  reorderLevel     Float           @default(0)
  lastCostPrice    Float           @default(0)
  vendorId         String?
  lastPurchaseDate DateTime?
  isUncertain      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  lineItems    BillLineItem[]
  movements    InventoryMovement[]
  recipeUses   RecipeIngredient[]
  wasteEntries WasteEntry[]
  stockCounts  StockCount[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([category])
}

model Bill {
  id            String          @id @default(cuid())
  restaurantId  String
  billNumber    String
  billNumberRaw String?
  type          BillType        @default(INVOICE)
  date          DateTime
  dueDate       DateTime?
  vendorId      String
  subtotal      Float
  sgst          Float           @default(0)
  cgst          Float           @default(0)
  roundoff      Float           @default(0)
  grandTotal    Float
  paymentStatus PaymentStatus   @default(UNKNOWN)
  category      ProductCategory @default(OTHER)
  notes         String?
  isUncertain   Boolean         @default(false)
  sourceFile    String?
  sourcePages   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  lineItems  BillLineItem[]
  movements  InventoryMovement[]

  @@index([restaurantId])
  @@index([date])
  @@index([vendorId])
}

// No restaurantId — scoped through `bill: { restaurantId }`.
model BillLineItem {
  id             String  @id @default(cuid())
  billId         String
  productId      String
  productNameRaw String
  unit           String
  hsn            String?
  mrp            Float   @default(0)
  quantity       Float
  rate           Float
  discount       Float   @default(0)
  sgstRate       Float   @default(0)
  cgstRate       Float   @default(0)
  amount         Float

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
}

// No restaurantId — scoped through `product: { restaurantId }`.
model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  billId    String?
  type      MovementType
  quantity  Float
  date      DateTime
  notes     String?
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  bill    Bill?   @relation(fields: [billId], references: [id])

  @@index([productId])
  @@index([date])
}

// ---- Sales & Growth ----
// Revenue side of the business. Sales data comes either from a PetPooja
// export (Orders Master / Executive Summary / Day End, or an item-wise CSV)
// or manual daily entry. Recipes link menu items back to the same Products
// already tracked on the purchase side, so food cost / margin per dish is
// computed from real ingredient prices, not guessed.

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  category     String?
  sellingPrice Float    @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipe     RecipeIngredient[]
  sales      MenuItemSale[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

// No restaurantId — scoped through `menuItem: { restaurantId }`.
model RecipeIngredient {
  id         String @id @default(cuid())
  menuItemId String
  productId  String
  quantity   Float
  unit       String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([menuItemId])
  @@index([productId])
}

// One row per calendar day per restaurant — the aggregate revenue/channel/
// payment-mode summary for that day, whether it came from a PetPooja import
// or manual entry. Two different restaurants both have a "28 July 2026", so
// the uniqueness that prevents duplicate entries is now (restaurant, date),
// not date alone.
model DailySales {
  id                 String   @id @default(cuid())
  restaurantId       String
  date               DateTime
  dineInRevenue      Float    @default(0)
  deliveryRevenue    Float    @default(0)
  takeawayRevenue    Float    @default(0)
  otherRevenue       Float    @default(0)
  cashAmount         Float    @default(0)
  upiAmount          Float    @default(0)
  cardAmount         Float    @default(0)
  otherPaymentAmount Float    @default(0)
  covers             Int      @default(0)
  source             String   @default("MANUAL")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItemSale[]

  @@unique([restaurantId, date])
  @@index([restaurantId])
  @@index([date])
}

// No restaurantId — scoped through `dailySales: { restaurantId }`.
model MenuItemSale {
  id           String @id @default(cuid())
  dailySalesId String
  menuItemId   String
  quantity     Float
  revenue      Float

  dailySales DailySales @relation(fields: [dailySalesId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])

  @@index([dailySalesId])
  @@index([menuItemId])
}

enum LaborCategory {
  WAGES
  SALARIES
  TIPS_PAYOUT
  OTHER
}

model LaborCost {
  id           String        @id @default(cuid())
  restaurantId String
  date         DateTime
  category     LaborCategory @default(WAGES)
  amount       Float
  notes        String?
  createdAt    DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([date])
}

model WasteEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  date          DateTime
  productId     String
  quantity      Float
  estimatedCost Float    @default(0)
  reason        String?
  notes         String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([restaurantId])
  @@index([productId])
  @@index([date])
}

// ---- Guests (CRM) ----
// Phase 1 of guest CRM: a guest profile plus a manually-logged visit history.
// There is no per-order POS integration yet (PetPooja sync is file-based
// report/CSV import, not a live API), so a visit is logged by staff rather
// than captured automatically from every sale — see CustomerVisit.source.

model Customer {
  id            String    @id @default(cuid())
  restaurantId  String
  phone         String
  name          String
  email         String?
  whatsappOptIn Boolean   @default(false)
  dietaryNotes  String?
  birthday      DateTime?
  anniversary   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visits     CustomerVisit[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

model CustomerVisit {
  id           String   @id @default(cuid())
  restaurantId String
  customerId   String
  date         DateTime
  amount       Float    @default(0)
  covers       Int?
  notes        String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([customerId])
  @@index([date])
}

// ---- Consumption tracking ----
// Bills only record what was bought. Consumption is tracked three ways and
// compared on /consumption: logged usage (InventoryMovement type CONSUMPTION,
// negative quantity like every other movement), recipe-expected usage
// (MenuItemSale x RecipeIngredient), and physical stock counts below.
// A count sets the product's stock to what was physically counted; `variance`
// (counted - system) is the unexplained gain/loss at that moment. `movementId`
// points at the ADJUSTMENT movement it wrote, so deleting a count can undo it.
model StockCount {
  id           String   @id @default(cuid())
  restaurantId String
  productId    String
  date         DateTime
  countedQty   Float
  systemQty    Float
  variance     Float
  movementId   String?
  notes        String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([productId])
  @@index([date])
}

// ---- Cash & statement expenses ----
// Money paid out that is not a vendor bill: petty cash, repairs, transport,
// staff tea, gas cylinders... or debits imported from a bank/UPI statement.
// `description` says WHAT it was; `explanation` says WHY, for later reference
// (e.g. "plumber for the kitchen drain, approved by owner"). Expenses in
// non-food categories count as operating expenses on the P&L. Vendor
// payments belong in the vendor ledger instead, or they would be counted
// twice (once as the bill, once as the expense).
model ExpenseStatement {
  id               String    @id @default(cuid())
  restaurantId     String
  fileName         String
  importedByName   String
  periodFrom       DateTime?
  periodTo         DateTime?
  transactionCount Int
  totalAmount      Float
  createdAt        DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@index([restaurantId])
}

model Expense {
  id            String          @id @default(cuid())
  restaurantId  String
  date          DateTime
  amount        Float
  category      ProductCategory @default(OTHER)
  paymentMethod PaymentMethod   @default(CASH)
  paidTo        String?
  description   String
  explanation   String?
  reference     String?
  source        String          @default("MANUAL")
  statementId   String?
  createdByName String
  createdAt     DateTime        @default(now())

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  statement  ExpenseStatement? @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([date])
  @@index([statementId])
}

// ---- Cash received ----
// Cash coming in that is NOT already a daily-sales entry: party/event advances,
// deposits, an owner top-up, a customer settling a credit sale. Cash from daily
// sales is read straight from DailySales.cashAmount, so it is never entered
// twice. `kind` is a plain string (labels live in code) to avoid enum churn.
model CashReceipt {
  id            String   @id @default(cuid())
  restaurantId  String
  date          DateTime
  amount        Float
  kind          String   @default("OTHER")
  receivedFrom  String?
  description   String
  explanation   String?
  reference     String?
  createdByName String
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([date])
}

// ---- Access control ----
// Sign-in gates the whole app. There is no public sign-up, ever, at any
// level. Three tiers:
//
//   SUPER_ADMIN       Partywalas platform. Creates restaurants and their
//                     first RESTAURANT_ADMIN. restaurantId is always null —
//                     that absence is what keeps them out of every
//                     restaurant-scoped query (see requireRestaurantUser).
//                     Cannot read any restaurant's business data.
//   RESTAURANT_ADMIN  Runs one restaurant's own CRM: full data access within
//                     that restaurant, plus can invite/manage that
//                     restaurant's own USER and RESTAURANT_ADMIN accounts.
//   USER              Full data access within their one restaurant, no user
//                     management.
//
// Passwords are stored as scrypt hashes (see src/lib/password.ts), never in
// plain text, and the session itself is a signed JWT cookie.

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  USER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  email        String?
  role         UserRole  @default(USER)
  restaurantId String? // null only for SUPER_ADMIN
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([restaurantId])
}

// ---- Audit trail ----
// Who changed what, when, at which restaurant. userName is denormalized on
// purpose: the log has to stay readable after an account is deleted, and a
// foreign key would either block that deletion or cascade the history away
// with it. restaurantId is null for platform-level actions (e.g. a
// SUPER_ADMIN creating a restaurant) and set for everything else.

model ActivityLog {
  id           String   @id @default(cuid())
  restaurantId String?
  userId       String?
  userName     String
  action       String // CREATE | UPDATE | DELETE | IMPORT
  entity       String // Bill | Payment | Vendor | Product | DailySales | User | Restaurant | ...
  entityId     String?
  summary      String
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
}
